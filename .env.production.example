APP_NAME=NussoraPos
APP_ENV=production
APP_KEY=
# Genera una clave propia para producción con:
#   php artisan key:generate --force
# (no reutilices la de tu entorno local)
APP_DEBUG=false
APP_URL=https://TU-DOMINIO.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

# Token que usa el agente de impresión local (el programa instalado en la
# PC del negocio) para autenticarse en /agente/* — ver routes/web.php. Debe
# ser EXACTAMENTE el mismo valor que tengas configurado en ese agente. Si
# vas a instalar el agente de nuevo en el servidor de producción, puedes
# generar uno nuevo (ej. con `php artisan tinker` -> Str::random(64)) y
# usarlo en ambos lados; si no, deja el mismo que ya usa el agente real.
AGENTE_IMPRESION_TOKEN=097bccb00a901f179f17ea59e2529d3683ebd096539b8c96b5bd8da953df2fb5

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Datos que Hostinger te da al crear la base de datos MySQL en hPanel
# (hPanel > Bases de datos > MySQL). El nombre suele llevar el prefijo de
# tu cuenta, ej. u123456789_nexora.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u123456789_nexora
DB_USERNAME=u123456789_nexora
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Sin SMTP configurado, esto solo deja los correos en el log — no se
# envían de verdad. Si necesitas que salgan correos reales (ej. facturas
# electrónicas a clientes), Hostinger te da credenciales SMTP en
# hPanel > Emails > Cuentas de correo, y cambias estas 3 líneas por esas.
MAIL_MAILER=log

# Facturación electrónica DIAN (Factus) — EN SANDBOX, apagada a propósito
# (FACTURA_ELECTRONICA_HABILITADA=false) para no transmitir nada real por
# accidente. Cuando quieras activarla de verdad, Factus te da credenciales
# de PRODUCCIÓN distintas a estas (sandbox) — cámbialas aquí y recién ahí
# pon el flag en true.
FACTURA_ELECTRONICA_HABILITADA=false
FACTUS_API_URL=https://api-sandbox.factus.com.co
FACTUS_CLIENT_ID=a2bebb27-6487-419d-aeb7-9e1c693f73e0
FACTUS_CLIENT_SECRET=8vukaICkU7UIDqYdweZlSq94WvIQkhScadfSkB6l
FACTUS_USERNAME=sandboxv2@factus.com.co
FACTUS_PASSWORD="sandbox2026%"

# Plan contratado por esta instalación (ver config/nexora.php):
#   basico -> POS, mesas, comandas, inventario, cierres de caja
#   pro    -> todo lo anterior + contabilidad, nómina, activos fijos,
#             tesorería, compras, cuentas por cobrar/pagar y facturación
#             electrónica DIAN
NEXORA_PLAN=pro

# Cierre de sesión por inactividad (minutos sin actividad antes de forzar
# logout). Más corto para Mesero/Cajero/Cocina porque son los roles que
# quedan expuestos si alguien deja la sesión abierta fuera del local.
INACTIVIDAD_OPERATIVOS_MINUTOS=15
INACTIVIDAD_ADMIN_MINUTOS=60

# Duración máxima de sesión (horas), distinta a la inactividad: cierra la
# sesión al cumplirse el turno aunque el usuario siga activo (la pantalla
# de facturación se autorefresca sola, así que nunca "parece" inactiva por
# sí misma). 0 = sin límite. Todo esto también se puede editar desde
# Configuración dentro de la app, sin tocar este archivo.
SESION_MAXIMA_OPERATIVOS_HORAS=8
SESION_MAXIMA_ADMIN_HORAS=0
