APP_NAME=Nexora
APP_ENV=production
APP_KEY=
# Genera una clave propia para producción con:
#   php artisan key:generate --force
# (no reutilices la de tu entorno local)
APP_DEBUG=false
APP_URL=https://TU-DOMINIO.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Datos que Hostinger te da al crear la base de datos MySQL en hPanel
# (hPanel > Bases de datos > MySQL). El nombre suele llevar el prefijo de
# tu cuenta, ej. u123456789_nexora.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u123456789_nexora
DB_USERNAME=u123456789_nexora
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
